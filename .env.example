# ==============================================================================
# NTL AUCTION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (PHASE 5)
# Google Sheets-Only Architecture: No SQL, PostgreSQL, or Supabase Database
# Copy this file to .env.local and populate with your staging or production credentials.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="NTL Auction Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LEAGUE_SLUG="nalanda-turf-league"

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD SERVICE ACCOUNT (REQUIRED FOR GOOGLE SHEETS STORAGE & DRIVE)
# Service Account with Google Sheets API and Google Drive API enabled.
# Share your auction workbook and Drive folder with this service account email.
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL="ntl-auction-service@your-gcp-project.iam.gserviceaccount.com"

# Google Service Account Private Key (Format with literal \n escapes or quoted PEM)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. GOOGLE WORKSPACE DATA WORKBOOKS
# ------------------------------------------------------------------------------
# Primary Google Sheets Workbook ID (single source of truth for auction data)
# Contains 7 tabs: League_Config, Teams, Players, Auction_State, Bid_History, Purchases, Audit_Log
GOOGLE_SHEETS_DATABASE_ID="your_google_sheets_auction_database_workbook_id"

# Registration Sheet ID (Source for importing player registrations into the auction)
GOOGLE_SHEET_ID="your_registration_spreadsheet_id_here"

# Google Drive Folder ID containing player portrait photographs
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_for_player_photos"

# ------------------------------------------------------------------------------
# 4. OPTIONAL ADMIN CREDENTIALS (DEMO / INITIAL LOGIN)
# ------------------------------------------------------------------------------
DEMO_ADMIN_EMAIL="admin@ntlcricket.com"
DEMO_ADMIN_PASSWORD="CHANGE_ME_IN_PRODUCTION"
