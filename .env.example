# ==============================================================================
# NALANDA TURF LEAGUE SEASON 1 — ENVIRONMENT CONFIGURATION
# Dedicated single-league auction platform with Google Apps Script Sheets persistence
# ZERO Google Cloud Service Accounts. ZERO SQL/PostgreSQL/Supabase/Firebase/Redis databases.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Nalanda Turf League Season 1"
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"

# ------------------------------------------------------------------------------
# 2. GOOGLE APPS SCRIPT PERSISTENCE (ZERO GCP ACCOUNTS REQUIRED)
# Deploy apps-script/Code.gs as a Web App with access set to "Anyone"
# ------------------------------------------------------------------------------
APPS_SCRIPT_WEB_APP_URL="https://script.google.com/macros/s/AKfycb.../exec"
APPS_SCRIPT_SHARED_SECRET="generate-a-strong-random-shared-secret-key"

# ------------------------------------------------------------------------------
# 3. AUCTION COMMISSIONER / ADMIN AUTHENTICATION
# Credentials used to log in at /admin/login to access /admin/auction-control
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@ntlcricket.com"
ADMIN_PASSWORD="CHANGE_ME_SECURE_PASSWORD"
ADMIN_SESSION_SECRET="generate-a-random-32-char-string-for-jwt-signing"


