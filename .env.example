NEXT_PUBLIC_APP_NAME="Nalanda Turf League Season 1"
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"

# PostgreSQL. Use a pooled connection URL for Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# SSE listener requires a DIRECT Neon URL (no -pooler in hostname). Server-only.
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Server-only UploadThing credential. Do not expose or commit a real token.
UPLOADTHING_TOKEN="sk_live_replace_with_your_uploadthing_token"

ADMIN_EMAIL="admin@ntlcricket.com"
ADMIN_PASSWORD="CHANGE_ME_SECURE_PASSWORD"
ADMIN_SESSION_SECRET="generate-a-random-32-char-string-for-jwt-signing"
